<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz_alarme"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_alarme_gradiente"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">

        <ImageView
            android:id="@+id/btn_voltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/verde_tinta"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip_verde">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                app:tint="@color/verde_principal" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AmparoMed · agora"
            android:textColor="@color/verde_principal"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chip_pessego">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell"
            app:tint="@color/pessego" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Hora do medicamento"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/verde_tinta" />

    <TextView
        android:id="@+id/txt_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20:00"
        android:textSize="64sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/verde_tinta"
        android:letterSpacing="-0.03"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_roxo">

                <ImageView
                    android:id="@+id/img_forma"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pill"
                    app:tint="@color/roxo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txt_nome_alarme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atorvastatina"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/verde_tinta" />

                <TextView
                    android:id="@+id/txt_dose_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20mg · comprimido"
                    android:textSize="14sp"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dose_linha"
            android:padding="10dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tomar agora"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txt_tomar_agora"
                style="@style/Texto.Valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 comprimido" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dose_linha"
            android:padding="10dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restam no estoque"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txt_restam"
                style="@style/Texto.Valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 cps" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirmar"
        style="@style/Botao.Primario"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="Confirmar medicamento"
        android:textSize="16sp"
        app:icon="@drawable/ic_check_circle"
        app:iconSize="22dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nao_tomei"
        style="@style/Botao.PerigoContorno"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="Não tomei"
        app:icon="@drawable/ic_x" />

    <TextView
        android:id="@+id/txt_nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Se não tomar, o próximo horário é amanhã às 20:00."
        android:textSize="12sp"
        android:textColor="@color/texto_secundario" />

</LinearLayout>
