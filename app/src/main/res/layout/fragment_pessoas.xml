<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/creme">

    <include layout="@layout/layout_barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_segmento_container"
        android:padding="4dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <TextView
            android:id="@+id/seg_paciente"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Paciente"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/segmento_texto"
            android:background="@drawable/bg_segmento_item"
            android:drawableStart="@drawable/ic_heart"
            android:drawablePadding="6dp"
            android:drawableTint="@color/segmento_texto" />

        <TextView
            android:id="@+id/seg_cuidadores"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cuidadores"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/segmento_texto"
            android:background="@drawable/bg_segmento_item"
            android:drawableStart="@drawable/ic_users"
            android:drawablePadding="6dp"
            android:drawableTint="@color/segmento_texto" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/grupo_paciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_grande"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txt_iniciais_pac"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:background="@drawable/bg_oval_verde_claro"
                        android:text="MC"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/verde_principal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/txt_nome_pac"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maria Clara Silva"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/verde_tinta" />

                        <TextView
                            android:id="@+id/txt_idade_pac"
                            style="@style/Texto.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72 anos"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_editar_pac"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip_verde"
                        android:scaleType="center"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/verde_principal"
                        android:contentDescription="Editar paciente" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_grande"
                    android:padding="14dp"
                    android:layout_marginTop="9dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="10dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_chip_verde"><ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/ic_calendar" app:tint="@color/verde_principal" /></FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView style="@style/Texto.CampoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data de nascimento" />
                            <TextView android:id="@+id/txt_nascimento" style="@style/Texto.Valor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14/03/1954" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/borda" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="4dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_chip_verde"><ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/ic_id_card" app:tint="@color/verde_principal" /></FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView style="@style/Texto.CampoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPF" />
                            <TextView android:id="@+id/txt_cpf_pac" style="@style/Texto.Valor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="123.456.789-00" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_grande"
                    android:padding="14dp"
                    android:layout_marginTop="9dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_alert" app:tint="@color/vermelho" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="ALERGIA A MEDICAMENTOS" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/vermelho" android:letterSpacing="0.05" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_alergias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_grande"
                    android:padding="14dp"
                    android:layout_marginTop="9dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_heart" app:tint="@color/pessego" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="DOENÇAS" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/pessego" android:letterSpacing="0.05" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_doencas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/grupo_cuidadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_cuidadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_cuidador"
                    style="@style/Botao.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Adicionar familiar ou cuidador"
                    app:icon="@drawable/ic_plus" />
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
