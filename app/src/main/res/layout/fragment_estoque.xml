<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/creme">

    <include layout="@layout/layout_barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_adicionar_med"
            style="@style/Botao.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar medicamento"
            app:icon="@drawable/ic_plus" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">

            <TextView
                android:id="@+id/txt_contagem"
                style="@style/Texto.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 MEDICAMENTOS" />

            <TextView
                style="@style/Texto.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acaba primeiro no topo" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_estoque"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="9dp"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
