<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de cadastro — APENAS VISUAL (sem persistencia). Botao Cadastrar abre o app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_oval_verde_claro">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                app:tint="@color/verde_principal" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Criar conta"
            android:textSize="30sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/verde_principal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="Leva menos de um minuto."
            android:textSize="14sp"
            android:textColor="@color/texto_secundario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_grande"
            android:padding="20dp">

            <TextView
                style="@style/Texto.CampoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome completo" />

            <EditText
                android:id="@+id/edit_nome"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="Seu nome"
                android:inputType="textCapWords"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="10dp"
                android:drawableTint="@color/texto_secundario" />

            <TextView
                style="@style/Texto.CampoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="E-mail" />

            <EditText
                android:id="@+id/edit_email"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="voce@email.com"
                android:inputType="textEmailAddress"
                android:drawableStart="@drawable/ic_mail"
                android:drawablePadding="10dp"
                android:drawableTint="@color/texto_secundario" />

            <TextView
                style="@style/Texto.CampoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Senha" />

            <EditText
                android:id="@+id/edit_senha"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="••••••••"
                android:inputType="textPassword" />

            <TextView
                style="@style/Texto.CampoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirmar senha" />

            <EditText
                android:id="@+id/edit_confirmar"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="••••••••"
                android:inputType="textPassword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cadastrar"
                style="@style/Botao.Primario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Cadastrar" />

            <TextView
                android:id="@+id/btn_ja_tenho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="4dp"
                android:text="Já tenho conta · Entrar"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/verde_principal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Protótipo acadêmico · sem cadastro real"
            android:textSize="12sp"
            android:textColor="@color/texto_riscado" />

    </LinearLayout>

</ScrollView>
