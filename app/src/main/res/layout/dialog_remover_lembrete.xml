<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_chip_vermelho">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trash"
            app:tint="@color/vermelho" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_dlg_titulo"
        style="@style/Texto.DialogoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Remover este lembrete?" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/txt_dlg_nome"
            style="@style/Texto.ItemTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atorvastatina 20mg" />

        <TextView
            android:id="@+id/txt_dlg_sub"
            style="@style/Texto.ItemSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 comprimido · 20:00 · todo dia" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_dlg_corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Você deixa de receber este aviso. O estoque do remédio não muda."
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar"
            style="@style/Botao.Neutro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar" />

        <Space android:layout_width="10dp" android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remover"
            style="@style/Botao.Perigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remover" />
    </LinearLayout>

</LinearLayout>
