<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/creme">

    <include layout="@layout/layout_barra_topo" />

    <LinearLayout
        android:id="@+id/corpo_emergencia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_halo_emergencia">

                <LinearLayout
                    android:id="@+id/nucleo_samu"
                    android:layout_width="114dp"
                    android:layout_height="114dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_nucleo_emergencia"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ligar para o SAMU, 192">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/branco" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/branco" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="LIGAR PARA O SAMU"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/vermelho"
                android:letterSpacing="0.14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:maxWidth="250dp"
                android:text="Toque no botão vermelho para ligar."
                android:textSize="13sp"
                android:textColor="@color/texto_secundario" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Rotulo.Terracota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="9dp"
            android:text="Familiares e cuidadores" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_emergencia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
