<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pegador" />

        <TextView
            style="@style/Texto.DialogoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo lembrete" />

        <TextView
            style="@style/Texto.CampoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Medicamento" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingLeft="8dp"
            android:paddingRight="10dp"
            android:layout_marginTop="6dp">

            <Spinner
                android:id="@+id/spinner_medicamento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.CampoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantidade por dose" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageButton
                        android:id="@+id/btn_qtd_menos"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input"
                        android:scaleType="center"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/verde_principal"
                        android:contentDescription="Diminuir" />

                    <TextView
                        android:id="@+id/txt_qtd"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/verde_tinta"
                        android:background="@drawable/bg_input" />

                    <ImageButton
                        android:id="@+id/btn_qtd_mais"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input"
                        android:scaleType="center"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/verde_principal"
                        android:contentDescription="Aumentar" />
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="10dp" android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.CampoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primeiro horário" />

                <LinearLayout
                    android:id="@+id/campo_horario"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/verde_principal" />

                    <TextView
                        android:id="@+id/txt_horario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:00"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/verde_tinta" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Texto.CampoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tomar a cada" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_intervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip android:id="@+id/chip_4h" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4h" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_6h" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6h" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_8h" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8h" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_12h" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12h" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_24h" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24h" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/Texto.CampoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Por quantos dias" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip android:id="@+id/chip_7d" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 dias" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_15d" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 dias" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_30d" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 dias" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_outro" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outro" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_indef" style="@style/AmparoChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Não definido" />
        </com.google.android.material.chip.ChipGroup>

        <EditText
            android:id="@+id/edit_outro"
            style="@style/Campo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Número de dias"
            android:inputType="number"
            android:visibility="gone" />

        <TextView
            style="@style/Texto.Ajuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Não definido: repete todo dia até você remover o lembrete." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancelar_sheet"
                style="@style/Botao.Neutro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar" />

            <Space android:layout_width="10dp" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_salvar_sheet"
                style="@style/Botao.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Salvar" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
