<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_chip_verde">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_box"
            app:tint="@color/verde_principal" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_repor_titulo"
        style="@style/Texto.DialogoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Repor Losartana 50mg" />

    <TextView
        android:id="@+id/txt_repor_pergunta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Quantos comprimidos chegaram?"
        android:textSize="14sp"
        android:textColor="@color/texto_secundario" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <ImageButton
            android:id="@+id/btn_repor_menos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:scaleType="center"
            android:src="@drawable/ic_minus"
            app:tint="@color/verde_principal"
            android:contentDescription="Diminuir" />

        <TextView
            android:id="@+id/txt_repor_qtd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:text="+ 30"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/verde_tinta"
            android:background="@drawable/bg_input" />

        <ImageButton
            android:id="@+id/btn_repor_mais"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:scaleType="center"
            android:src="@drawable/ic_plus"
            app:tint="@color/verde_principal"
            android:contentDescription="Aumentar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_resumo_verde"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/txt_repor_atuais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 atuais → novo total"
            android:textSize="14sp"
            android:textColor="@color/verde_tinta" />

        <TextView
            android:id="@+id/txt_repor_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33 cps"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="@color/verde_principal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_repor_cancelar"
            style="@style/Botao.Neutro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar" />

        <Space android:layout_width="10dp" android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_repor_ok"
            style="@style/Botao.Primario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Repor" />
    </LinearLayout>

</LinearLayout>
